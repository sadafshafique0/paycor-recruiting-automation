    "screen-job": "node cli/screen-job.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.45.0",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4"
  }
