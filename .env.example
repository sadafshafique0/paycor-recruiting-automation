# Copy to .env (never commit the real one). Loaded by src/config.js.

# Required for the resume-screening judgment service (src/screening/resumeJudge.js).
# Billed per token, not per seat — see docs/ARCHITECTURE.md for cost notes.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for resume-fit screening. Sonnet 5 is the recommended default for this workload
# (high-volume, well-specified, cost-sensitive) — see docs/ARCHITECTURE.md for the cost math
# before switching to a pricier model.
SCREENING_MODEL=claude-sonnet-5

# Local dashboard port.
PORT=4178
